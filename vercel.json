{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/guest-upload-cleanup",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/love-galaxy-cleanup",
      "schedule": "30 0 * * *"
    }
  ]
}
